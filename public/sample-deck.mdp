# Interactive HTML5 Canvas
### Live Particle Waves Inside Any Slide

<canvas id="particleCanvas" width="900" height="420" class="w-full h-80 rounded-2xl border border-white/10 shadow-2xl bg-[#090d16]"></canvas>

<script>
  const canvas = document.getElementById('particleCanvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let step = 0;
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const points = 45;
      const width = canvas.width;
      const height = canvas.height;
      for (let i = 0; i < points; i++) {
        const x = (i / points) * width;
        const y = height / 2 + Math.sin(step * 0.05 + i * 0.25) * 60;
        const radius = 4 + Math.sin(step * 0.08 + i) * 2;
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fillStyle = `hsl(${(i * 12 + step * 2) % 360}, 85%, 65%)`;
        ctx.shadowColor = ctx.fillStyle;
        ctx.shadowBlur = 10;
        ctx.fill();
      }
      step++;
      requestAnimationFrame(draw);
    }
    draw();
  }
</script>

