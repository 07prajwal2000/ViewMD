{
  "name": "ViewMD - Markdown & Presentation Viewer",
  "short_name": "ViewMD",
  "description": "Fast, bloat-free, 100% client-side Markdown viewer, editor, and Keynote presentation slide deck engine (.mdp, .deck) with live preview, tabbed browsing, split pane editing, frontmatter inspector, and direct local disk saving.",
  "id": "viewmd-markdown-app",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#161b22",
  "categories": [
    "productivity",
    "utilities",
    "developer tools"
  ],
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Markdown Presentation Deck",
      "accept": {
        "text/markdown": [
          ".mdp",
          ".deck"
        ],
        "text/x-markdown": [
          ".mdp",
          ".deck"
        ],
        "text/plain": [
          ".mdp",
          ".deck"
        ]
      },
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./",
      "name": "Markdown Document",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown",
          ".mdown",
          ".mkd"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshot.png",
      "sizes": "1910x872",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ViewMD Split Editor & GFM Preview"
    }
  ]
}
