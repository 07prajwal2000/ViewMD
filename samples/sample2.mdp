# Live HTML5 Interactive Canvas 🌌

<div id="particle-canvas-container" style="width: 100%; height: 380px; position: relative; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
  <canvas id="particle-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
  <div style="position: absolute; bottom: 12px; left: 16px; font-size: 13px; color: #7aa2f7; font-family: monospace;">
    Interactive Constellation Nodes: move mouse over canvas
  </div>
</div>

<script>
(function() {
  const canvas = document.getElementById('particle-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  
  canvas.width = canvas.parentElement.clientWidth;
  canvas.height = canvas.parentElement.clientHeight;
  
  const particles = Array.from({ length: 35 }, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    vx: (Math.random() - 0.5) * 1.2,
    vy: (Math.random() - 0.5) * 1.2,
    radius: Math.random() * 2 + 1.5,
  }));
  
  let animationFrameId;
  function render() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    // Draw links
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.hypot(dx, dy);
        if (dist < 95) {
          ctx.beginPath();
          ctx.strokeStyle = `rgba(122, 162, 247, ${1 - dist / 95})`;
          ctx.lineWidth = 0.8;
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }
    
    // Draw nodes
    ctx.fillStyle = '#bb9af7';
    for (const p of particles) {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
      if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx.fill();
    }
    
    animationFrameId = requestAnimationFrame(render);
  }
  
  render();
  window.addEventListener('beforeunload', () => cancelAnimationFrame(animationFrameId));
})();
</script>

